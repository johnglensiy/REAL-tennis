{
    "manifest_version": 3,
    "name": "Real Tennis",
    "version": "0.1.0",
    "description": "Live tennis match data",
    "action": {},
    "content_scripts": [{
      "matches": ["https://example.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }],
    "host_permissions": [
      "http://localhost:3000/*"
    ]
  }